# Copy this file to .env and fill in real values. Never commit .env.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Project Settings -> API -> "service_role" secret key (NOT the publishable/anon key).
# This key bypasses Row Level Security entirely - keep it out of git, out of the
# Android app, and never ship it anywhere client-side.
SUPABASE_SERVICE_ROLE_KEY=
